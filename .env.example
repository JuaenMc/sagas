# Backend API URL (e.g., https://sagasbackend.onrender.com or https://api.sagas.moda)
VITE_BACKEND_URL="https://sagasbackend.onrender.com"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Domain or deployment URL for callbacks (e.g., https://sagas.moda)
APP_URL="https://sagas.moda"

# Mercado Pago Integrations
VITE_MERCADOPAGO_PUBLIC_KEY="APP_USR-..."
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

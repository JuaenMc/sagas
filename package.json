{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "android:init": "cap add android",
    "build:apk": "vite build && cap sync android && cd android && gradlew.bat assembleDebug && cd .. && node -e \"const fs=require('fs'); fs.mkdirSync('dist/android/app/build/outputs/apk', {recursive:true}); fs.copyFileSync('android/app/build/outputs/apk/debug/app-debug.apk', 'dist/android/app/build/outputs/apk/app-debug.apk');\"",
    "open:android": "cap open android",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@mercadopago/sdk-react": "^1.0.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "mercadopago": "^3.6.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.21.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
